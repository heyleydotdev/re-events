{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reevents/my-bookings",
	"title": "My Bookings",
	"category": "widgets",
	"icon": "list-view",
	"description": "Display bookings owned by the current user.",
	"keywords": [ "bookings", "user", "reevents" ],
	"textdomain": "re-events",
	"attributes": {
		"className": {
			"type": "string",
			"default": ""
		},
		"wrapperClass": {
			"type": "string",
			"default": ""
		},
		"limit": {
			"type": "number",
			"default": 20
		},
		"emptyLabel": {
			"type": "string",
			"default": "You have no bookings yet."
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js"
}
