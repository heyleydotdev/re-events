{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reevents/bookings",
	"title": "My Bookings",
	"category": "widgets",
	"icon": "tickets-alt",
	"description": "Show the visitor's bookings with cancel and restore actions.",
	"keywords": [ "bookings", "rsvp", "my bookings", "reevents" ],
	"textdomain": "re-events",
	"attributes": {
		"limit": {
			"type": "number",
			"default": 20
		},
		"showHeading": {
			"type": "boolean",
			"default": true
		},
		"dateFormat": {
			"type": "string",
			"default": ""
		},
		"timeFormat": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js"
}
