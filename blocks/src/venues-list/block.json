{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reevents/venues-list",
	"title": "Venues List",
	"category": "widgets",
	"icon": "location",
	"description": "Display venues.",
	"keywords": [ "venues", "locations", "reevents" ],
	"textdomain": "re-events",
	"attributes": {
		"limit": {
			"type": "number",
			"default": 10
		},
		"search": {
			"type": "string",
			"default": ""
		},
		"order": {
			"type": "string",
			"default": "asc"
		},
		"orderby": {
			"type": "string",
			"default": "title"
		},
		"upcoming": {
			"type": "boolean",
			"default": false
		},
		"showDescription": {
			"type": "boolean",
			"default": true
		},
		"excerptLength": {
			"type": "number",
			"default": 30
		},
		"showImage": {
			"type": "boolean",
			"default": false
		},
		"imageSize": {
			"type": "string",
			"default": "thumbnail"
		},
		"showAddress": {
			"type": "boolean",
			"default": false
		},
		"showWebsite": {
			"type": "boolean",
			"default": false
		},
		"showMapLink": {
			"type": "boolean",
			"default": false
		},
		"showNextEvent": {
			"type": "boolean",
			"default": false
		},
		"titleTag": {
			"type": "string",
			"default": "a"
		},
		"link": {
			"type": "boolean",
			"default": true
		},
		"paginate": {
			"type": "boolean",
			"default": true
		},
		"paginationKey": {
			"type": "string",
			"default": ""
		},
		"dateFormat": {
			"type": "string",
			"default": ""
		},
		"timeFormat": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js"
}
