{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reevents/venues-list",
	"title": "Venues List",
	"category": "widgets",
	"icon": "location",
	"description": "Display venues.",
	"keywords": [ "venues", "locations", "reevents" ],
	"textdomain": "re-events",
	"attributes": {
		"limit": {
			"type": "number",
			"default": 10
		},
		"showDescription": {
			"type": "boolean",
			"default": true
		},
		"paginate": {
			"type": "boolean",
			"default": true
		},
		"paginationKey": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js"
}
