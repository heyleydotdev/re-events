{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reevents/calendar",
	"title": "Events Calendar",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "Display a month calendar of events.",
	"keywords": [ "events", "calendar", "reevents" ],
	"textdomain": "re-events",
	"attributes": {
		"category": {
			"type": "string",
			"default": "0"
		},
		"tag": {
			"type": "string",
			"default": ""
		},
		"venue": {
			"type": "number",
			"default": 0
		},
		"organizer": {
			"type": "number",
			"default": 0
		},
		"showCancelled": {
			"type": "boolean",
			"default": false
		},
		"showToday": {
			"type": "boolean",
			"default": false
		},
		"weekStart": {
			"type": "string",
			"default": "mon"
		},
		"showNav": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js"
}
