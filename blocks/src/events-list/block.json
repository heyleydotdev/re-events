{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reevents/events-list",
	"title": "Events List",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "Display upcoming events.",
	"keywords": [ "events", "calendar", "reevents" ],
	"textdomain": "re-events",
	"attributes": {
		"limit": {
			"type": "number",
			"default": 5
		},
		"category": {
			"type": "number",
			"default": 0
		},
		"venue": {
			"type": "number",
			"default": 0
		},
		"upcoming": {
			"type": "boolean",
			"default": true
		},
		"useQuery": {
			"type": "boolean",
			"default": false
		},
		"showVenue": {
			"type": "boolean",
			"default": true
		},
		"paginate": {
			"type": "boolean",
			"default": true
		},
		"paginationKey": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js"
}
