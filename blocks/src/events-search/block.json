{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reevents/events-search",
	"title": "Events Search",
	"category": "widgets",
	"icon": "search",
	"description": "Search and filter events.",
	"keywords": [ "events", "search", "filter", "reevents" ],
	"textdomain": "re-events",
	"attributes": {
		"limit": {
			"type": "number",
			"default": 20
		},
		"showKeyword": {
			"type": "boolean",
			"default": true
		},
		"showCategory": {
			"type": "boolean",
			"default": true
		},
		"showVenue": {
			"type": "boolean",
			"default": true
		},
		"showDates": {
			"type": "boolean",
			"default": true
		},
		"showUpcoming": {
			"type": "boolean",
			"default": true
		},
		"showResults": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js"
}
