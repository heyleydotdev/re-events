{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reevents/events-search",
	"title": "Events Search",
	"category": "widgets",
	"icon": "search",
	"description": "Search and filter events.",
	"keywords": [ "events", "search", "filter", "reevents" ],
	"textdomain": "re-events",
	"attributes": {
		"limit": {
			"type": "number",
			"default": 20
		},
		"showKeyword": {
			"type": "boolean",
			"default": true
		},
		"showCategory": {
			"type": "boolean",
			"default": true
		},
		"showTag": {
			"type": "boolean",
			"default": false
		},
		"showVenue": {
			"type": "boolean",
			"default": true
		},
		"showOrganizer": {
			"type": "boolean",
			"default": false
		},
		"showDates": {
			"type": "boolean",
			"default": true
		},
		"showUpcoming": {
			"type": "boolean",
			"default": true
		},
		"showOrder": {
			"type": "boolean",
			"default": false
		},
		"order": {
			"type": "string",
			"default": "asc"
		},
		"showResults": {
			"type": "boolean",
			"default": true
		},
		"paginate": {
			"type": "boolean",
			"default": false
		},
		"paginationKey": {
			"type": "string",
			"default": ""
		},
		"showImage": {
			"type": "boolean",
			"default": false
		},
		"imageSize": {
			"type": "string",
			"default": "thumbnail"
		},
		"showPrice": {
			"type": "boolean",
			"default": false
		},
		"showExcerpt": {
			"type": "boolean",
			"default": false
		},
		"showCategories": {
			"type": "boolean",
			"default": false
		},
		"showTags": {
			"type": "boolean",
			"default": false
		},
		"showOrganizers": {
			"type": "boolean",
			"default": false
		},
		"showEnd": {
			"type": "boolean",
			"default": false
		},
		"showSeatsLeft": {
			"type": "boolean",
			"default": false
		},
		"showCancelled": {
			"type": "boolean",
			"default": false
		},
		"titleTag": {
			"type": "string",
			"default": "a"
		},
		"link": {
			"type": "boolean",
			"default": true
		},
		"dateFormat": {
			"type": "string",
			"default": ""
		},
		"timeFormat": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js"
}
