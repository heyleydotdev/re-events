{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reevents/my-events",
	"title": "My Events",
	"category": "widgets",
	"icon": "calendar",
	"description": "Display events owned by the current user.",
	"keywords": [ "events", "user", "reevents" ],
	"textdomain": "re-events",
	"attributes": {
		"className": {
			"type": "string",
			"default": ""
		},
		"wrapperClass": {
			"type": "string",
			"default": ""
		},
		"limit": {
			"type": "number",
			"default": 20
		},
		"emptyLabel": {
			"type": "string",
			"default": "You have not submitted any events yet."
		},
		"editLabel": {
			"type": "string",
			"default": "Edit"
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js"
}
