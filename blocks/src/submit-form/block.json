{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reevents/submit-form",
	"title": "Event Submission",
	"category": "widgets",
	"icon": "edit",
	"description": "Display the front-end event submission form.",
	"keywords": [ "events", "submission", "reevents" ],
	"textdomain": "re-events",
	"attributes": {
		"className": {
			"type": "string",
			"default": ""
		},
		"wrapperClass": {
			"type": "string",
			"default": ""
		},
		"submitLabel": {
			"type": "string",
			"default": "Submit event"
		},
		"saveLabel": {
			"type": "string",
			"default": "Save changes"
		},
		"loginMessage": {
			"type": "string",
			"default": "Log in to submit an event."
		},
		"successMessage": {
			"type": "string",
			"default": "Thank you. Your event is awaiting review."
		},
		"publishedMessage": {
			"type": "string",
			"default": "Thank you. Your event is published."
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js"
}
