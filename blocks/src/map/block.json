{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reevents/map",
	"title": "Venues Map",
	"category": "widgets",
	"icon": "location",
	"description": "Display venues on a map.",
	"keywords": [ "events", "venues", "map", "reevents" ],
	"textdomain": "re-events",
	"attributes": {
		"limit": {
			"type": "number",
			"default": 50
		},
		"height": {
			"type": "number",
			"default": 400
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js"
}
