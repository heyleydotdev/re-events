{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reevents/map",
	"title": "Venues Map",
	"category": "widgets",
	"icon": "location",
	"description": "Display venues on a map.",
	"keywords": [ "events", "venues", "map", "reevents" ],
	"textdomain": "re-events",
	"attributes": {
		"limit": {
			"type": "number",
			"default": 50
		},
		"height": {
			"type": "number",
			"default": 400
		},
		"venue": {
			"type": "number",
			"default": 0
		},
		"upcoming": {
			"type": "boolean",
			"default": false
		},
		"search": {
			"type": "string",
			"default": ""
		},
		"center": {
			"type": "string",
			"default": ""
		},
		"zoom": {
			"type": "number",
			"default": 0
		},
		"fit": {
			"type": "boolean",
			"default": false
		},
		"link": {
			"type": "boolean",
			"default": true
		},
		"provider": {
			"type": "string",
			"default": ""
		},
		"showAddress": {
			"type": "boolean",
			"default": false
		},
		"showNextEvent": {
			"type": "boolean",
			"default": false
		},
		"dateFormat": {
			"type": "string",
			"default": ""
		},
		"timeFormat": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js"
}
