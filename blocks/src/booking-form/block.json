{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reevents/booking-form",
	"title": "Booking Form",
	"category": "widgets",
	"icon": "tickets-alt",
	"description": "Display the ticket booking form for an event.",
	"keywords": [ "events", "booking", "tickets", "reevents" ],
	"textdomain": "re-events",
	"attributes": {
		"event": {
			"type": "number",
			"default": 0
		},
		"ticket": {
			"type": "number",
			"default": 0
		},
		"occurrence": {
			"type": "number",
			"default": 0
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"showPrice": {
			"type": "boolean",
			"default": true
		},
		"defaultQuantity": {
			"type": "number",
			"default": 1
		},
		"maxQuantity": {
			"type": "number",
			"default": 0
		},
		"hideSoldOut": {
			"type": "boolean",
			"default": false
		},
		"buttonLabel": {
			"type": "string",
			"default": ""
		},
		"successMessage": {
			"type": "string",
			"default": ""
		},
		"dateFormat": {
			"type": "string",
			"default": ""
		},
		"timeFormat": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js"
}
