{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "reevents/event-details",
	"title": "Event Details",
	"category": "widgets",
	"icon": "calendar",
	"description": "Display a single event.",
	"keywords": [ "event", "details", "reevents" ],
	"textdomain": "re-events",
	"attributes": {
		"id": {
			"type": "number",
			"default": 0
		},
		"showImage": {
			"type": "boolean",
			"default": false
		},
		"imageSize": {
			"type": "string",
			"default": "large"
		},
		"showTitle": {
			"type": "boolean",
			"default": true
		},
		"titleTag": {
			"type": "string",
			"default": "h2"
		},
		"showStatus": {
			"type": "boolean",
			"default": true
		},
		"showVenue": {
			"type": "boolean",
			"default": true
		},
		"showVenueAddress": {
			"type": "boolean",
			"default": false
		},
		"showVenueMapLink": {
			"type": "boolean",
			"default": false
		},
		"showOrganizers": {
			"type": "boolean",
			"default": true
		},
		"showPrice": {
			"type": "boolean",
			"default": false
		},
		"showSeatsLeft": {
			"type": "boolean",
			"default": false
		},
		"showCategories": {
			"type": "boolean",
			"default": false
		},
		"showTags": {
			"type": "boolean",
			"default": false
		},
		"showExcerpt": {
			"type": "boolean",
			"default": false
		},
		"showEnd": {
			"type": "boolean",
			"default": true
		},
		"showOnlineLinks": {
			"type": "boolean",
			"default": true
		},
		"showCalendarLinks": {
			"type": "boolean",
			"default": true
		},
		"showContent": {
			"type": "boolean",
			"default": true
		},
		"dateFormat": {
			"type": "string",
			"default": ""
		},
		"timeFormat": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js"
}
