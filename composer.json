{
	"name": "reevents/reevents",
	"description": "Open-source event manager for WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.0",
		"rakit/validation": "^1.4",
		"rlanvin/php-rrule": "^3.0"
	},
	"autoload-dev": {
		"classmap": [
			"src/"
		]
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"doctrine/instantiator": "^1.5",
		"php-stubs/wordpress-stubs": "^6.5",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^2.0",
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.10",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"format": "phpcbf --standard=phpcs.xml.dist",
		"lint": "phpcs --standard=phpcs.xml.dist",
		"analyze": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=1G",
		"test": "phpunit --configuration phpunit.xml.dist",
		"test:integration": "phpunit --configuration phpunit-integration.xml.dist",
		"test:coverage": "phpunit --configuration phpunit.xml.dist --coverage-text --coverage-clover coverage/unit.xml",
		"release": "bash bin/build-release.sh",
		"hooks": "git config core.hooksPath .githooks"
	}
}
