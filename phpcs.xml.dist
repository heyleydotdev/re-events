<?xml version="1.0"?>
<ruleset name="ReEvents">
	<description>Coding standards for the ReEvents plugin.</description>

	<file>.</file>
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>

	<config name="minimum_supported_wp_version" value="6.8"/>
	<config name="testVersion" value="8.2-"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>src/admin/views/*</exclude-pattern>
		<properties>
			<property name="prefixes" type="array">
				<element value="reevents"/>
				<element value="REEVENTS"/>
				<element value="ReEvents"/>
				<element value="re_events"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="re-events"/>
			</property>
		</properties>
	</rule>

	<!-- Lowercase hyphenated names inside src/; test files use the -test.php suffix. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>src/*</exclude-pattern>
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
</ruleset>
