<?xml version="1.0"?>
<ruleset name="ReEvents">
	<description>Coding standards for the ReEvents plugin.</description>

	<file>.</file>
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<!--
	 * PHP is formatted with Intelephense, which follows PSR-12 spacing.
	 * The sniffs below require WordPress-style paren spacing and a blank line
	 * after the file comment, so they are not enforced.
	-->
	<rule ref="WordPress-Extra">
		<exclude name="PEAR.Functions.FunctionCallSignature"/>
		<exclude name="WordPress.WhiteSpace.CastStructureSpacing"/>
		<exclude name="WordPress.WhiteSpace.ControlStructureSpacing"/>
		<exclude name="Generic.WhiteSpace.ArbitraryParenthesesSpacing"/>
		<exclude name="NormalizedArrays.Arrays.ArrayBraceSpacing"/>
		<exclude name="WordPress.Arrays.ArrayKeySpacingRestrictions"/>
		<exclude name="WordPress.WhiteSpace.OperatorSpacing"/>
		<exclude name="Universal.WhiteSpace.DisallowInlineTabs"/>
		<exclude name="Squiz.Strings.DoubleQuoteUsage"/>
	</rule>
	<rule ref="WordPress-Docs">
		<exclude name="Squiz.Commenting.FileComment.SpacingAfterOpen"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<config name="minimum_supported_wp_version" value="6.8"/>
	<config name="testVersion" value="8.2-"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>src/admin/views/*</exclude-pattern>
		<properties>
			<property name="prefixes" type="array">
				<element value="reevents"/>
				<element value="REEVENTS"/>
				<element value="ReEvents"/>
				<element value="re_events"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="re-events"/>
			</property>
		</properties>
	</rule>

	<!-- Lowercase hyphenated names inside src/; test files use the -test.php suffix. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>src/*</exclude-pattern>
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
</ruleset>
