{
  "name": "re-events",
  "version": "0.1.0",
  "private": true,
  "description": "Build tooling for ReEvents.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "dev": "vite",
    "preview": "vite preview",
    "format": "bun fmt \"assets/src/**/*.{css,ts,tsx}\" \"*.js\" \"tests/js/**/*.js\"",
    "format:check": "bun fmt --check \"assets/src/**/*.{css,ts,tsx}\" \"*.js\" \"tests/js/**/*.js\"",
    "test": "bun test tests/js"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@fontsource-variable/geist": "5.3.0",
    "@rolldown/plugin-babel": "^0.3.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6",
    "babel-plugin-react-compiler": "^1.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "vite": "8"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
