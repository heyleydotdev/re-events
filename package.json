{
  "name": "re-events",
  "version": "0.1.0",
  "private": true,
  "description": "Build tooling for ReEvents.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "dev": "vite",
    "preview": "vite preview",
    "format": "prettier --write \"assets/src/**/*.{css,ts}\" \"*.js\" \"tests/js/**/*.js\"",
    "format:check": "prettier --check \"assets/src/**/*.{css,ts}\" \"*.js\" \"tests/js/**/*.js\"",
    "format:tw": "tailwind-sort-php \"src/admin/views/**/*.php\"",
    "format:tw:file": "tailwind-sort-php",
    "check:tw": "tailwind-sort-php --check \"src/admin/views/**/*.php\"",
    "test": "bun test tests/js"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@runtimestudio/tailwind-sort-php": "0.4.0",
    "@tailwindcss/postcss": "4.3.5",
    "flowbite": "4.0.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "vite": "^8.3.6"
  }
}
