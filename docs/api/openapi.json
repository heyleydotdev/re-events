                                        "description": "Whether the event lasts all day."
                                    },
                                    "rrule": {
                                        "type": "string",
                                        "description": "RFC 5545 recurrence rule."
                                    },
                                    "exdates": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "description": "Excluded occurrence dates in UTC (Y-m-d H:i:s)."
                                    },
                                    "rdates": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "description": "Additional occurrence dates in UTC (Y-m-d H:i:s)."
                                    },
                                    "timeslots": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "start": {
                                                    "type": "string"
                                                },
                                                "end": {
                                                    "type": "string"
                                                },
                                                "capacity": {
                                                    "type": "integer"
                                                }
                                            }
                                        },
                                        "description": "Daily timeslots."
                                    },
                                    "venue_id": {
                                        "type": "integer",
                                        "description": "Venue post ID."
                                    },
                                    "organizer_ids": {
                                        "type": "array",
                                        "items": {
                                            "type": "integer"
                                        },
                                        "description": "Organizer post IDs."
                                    },
                                    "capacity": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "description": "Event capacity."
                                    },
                                    "online_urls": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "label": {
                                                    "type": "string"
                                                },
                                                "url": {
                                                    "type": "string"
                                                }
                                            }
                                        },
                                        "description": "Online event links."
                                    },
                                    "status": {
                                        "type": "string",
                                        "enum": [
                                            "scheduled",
                                            "cancelled"
                                        ],
                                        "description": "Event status."
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "operationId": "delete_events_id",
                "tags": [
                    "Events"
                ],
                "summary": "Delete Event",
                "responses": {
                    "200": {
                        "description": "Item deleted.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "deleted": {
                                            "type": "boolean"
                                        },
                                        "previous": {
                                            "$ref": "#/components/schemas/Event"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request data.",
