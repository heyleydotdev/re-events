                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "description": "Event title."
                                    },
                                    "start_utc": {
                                        "type": "string",
                                        "description": "Start time in UTC (Y-m-d H:i:s)."
