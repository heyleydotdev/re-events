{
    "openapi": "3.1.0",
    "info": {
        "title": "ReEvents API",
        "version": "0.1.0",
        "description": "REST API for events, venues, organizers and bookings."
    },
    "servers": [
        {
            "url": "/wp-json/re-events/v1",
            "description": "Current site"
        }
    ],
    "tags": [
        {
            "name": "System"
        },
        {
            "name": "Events"
        }
    ],
    "paths": {
        "/ping": {
            "get": {
                "operationId": "get_ping",
                "tags": [
                    "System"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Health"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/events": {
            "get": {
                "operationId": "get_events",
                "tags": [
                    "Events"
                ],
                "summary": "List Events",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Event"
                                    }
                                }
                            }
                        },
                        "headers": {
                            "X-WP-Total": {
                                "description": "Total number of matching items.",
                                "schema": {
                                    "type": "integer"
                                }
                            },
                            "X-WP-TotalPages": {
                                "description": "Total number of result pages.",
                                "schema": {
                                    "type": "integer"
                                }
                            }
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "context",
                        "in": "query",
                        "required": false,
                        "description": "Scope under which the request is made; determines fields present in response.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "description": "Current page of the collection.",
                        "schema": {
                            "type": "integer",
                            "default": 1,
                            "minimum": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "required": false,
                        "description": "Maximum number of items to be returned in result set.",
                        "schema": {
                            "type": "integer",
                            "default": 10,
                            "minimum": 1,
                            "maximum": 100
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "required": false,
                        "description": "Limit results to events matching a search term.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "category",
                        "in": "query",
                        "required": false,
                        "description": "Limit results to a category term ID.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "venue",
                        "in": "query",
                        "required": false,
                        "description": "Limit results to a venue ID.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "from",
                        "in": "query",
                        "required": false,
                        "description": "Only events starting on or after this date (Y-m-d, UTC).",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "required": false,
                        "description": "Only events starting on or before this date (Y-m-d, UTC).",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "upcoming",
                        "in": "query",
                        "required": false,
                        "description": "Only include upcoming events.",
                        "schema": {
                            "type": "boolean"
                        }
                    }
                ]
            },
            "post": {
                "operationId": "post_events",
                "tags": [
                    "Events"
                ],
                "summary": "Create Event",
                "responses": {
                    "201": {
                        "description": "Item created.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Event"
                                }
                            }
                        },
                        "headers": {
                            "Location": {
                                "description": "URL of the created item.",
                                "schema": {
                                    "type": "string",
                                    "format": "uri"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request data.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Authentication required.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Insufficient permissions.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "ApplicationPassword": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "description": "Event title."
                                    },
                                    "start_utc": {
                                        "type": "string",
                                        "description": "Start time in UTC (Y-m-d H:i:s)."
                                    },
                                    "end_utc": {
                                        "type": "string",
                                        "description": "End time in UTC (Y-m-d H:i:s)."
                                    },
                                    "timezone": {
                                        "type": "string",
                                        "description": "IANA timezone."
                                    },
                                    "all_day": {
                                        "type": "boolean",
                                        "description": "Whether the event lasts all day."
                                    },
                                    "rrule": {
                                        "type": "string",
                                        "description": "RFC 5545 recurrence rule."
                                    },
                                    "exdates": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "description": "Excluded occurrence dates in UTC (Y-m-d H:i:s)."
                                    },
                                    "rdates": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "description": "Additional occurrence dates in UTC (Y-m-d H:i:s)."
                                    },
                                    "timeslots": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "start": {
                                                    "type": "string"
                                                },
                                                "end": {
                                                    "type": "string"
                                                },
                                                "capacity": {
                                                    "type": "integer"
                                                }
                                            }
                                        },
                                        "description": "Daily timeslots."
                                    },
                                    "venue_id": {
                                        "type": "integer",
                                        "description": "Venue post ID."
                                    },
                                    "organizer_ids": {
                                        "type": "array",
                                        "items": {
                                            "type": "integer"
                                        },
                                        "description": "Organizer post IDs."
                                    },
                                    "capacity": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "description": "Event capacity."
                                    },
                                    "online_urls": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "label": {
                                                    "type": "string"
                                                },
                                                "url": {
                                                    "type": "string"
                                                }
                                            }
                                        },
                                        "description": "Online event links."
                                    },
                                    "status": {
                                        "type": "string",
                                        "enum": [
                                            "scheduled",
                                            "cancelled"
                                        ],
                                        "description": "Event status."
                                    }
                                },
                                "required": [
                                    "title",
                                    "start_utc"
                                ]
                            }
                        }
                    }
                }
            }
        },
