    "components": {
        "securitySchemes": {
            "ApplicationPassword": {
                "type": "http",
                "scheme": "basic",
                "description": "WordPress Application Password."
            }
        },
        "schemas": {
            "Error": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "data": {
                        "type": "object",
                        "properties": {
                            "status": {
                                "type": "integer"
                            }
                        }
                    }
                }
            },
            "Health": {
                "title": "health",
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string"
                    },
                    "version": {
                        "type": "string"
                    }
                }
            },
            "Event": {
                "title": "event",
                "type": "object",
                "properties": {
                    "id": {
                        "description": "Unique identifier for the event.",
                        "type": "integer",
                        "readonly": true
                    },
                    "title": {
                        "description": "Event title.",
                        "type": "string"
                    },
                    "start_utc": {
                        "description": "Start time in UTC.",
                        "type": "string",
                        "format": "date-time"
                    },
                    "end_utc": {
                        "description": "End time in UTC.",
                        "type": "string",
                        "format": "date-time"
                    },
                    "timezone": {
                        "description": "Event timezone.",
                        "type": "string"
                    },
                    "all_day": {
                        "description": "Whether the event lasts all day.",
                        "type": "boolean"
                    },
                    "rrule": {
                        "description": "Recurrence rule.",
                        "type": "string"
                    },
                    "exdates": {
                        "description": "Excluded occurrence dates.",
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "rdates": {
                        "description": "Additional occurrence dates.",
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "timeslots": {
                        "description": "Daily timeslots.",
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "start": {
                                    "type": "string"
                                },
                                "end": {
                                    "type": "string"
                                },
                                "capacity": {
                                    "type": "integer"
                                }
                            }
                        }
                    },
                    "venue_id": {
                        "description": "Venue post ID.",
                        "type": "integer"
                    },
                    "organizer_ids": {
                        "description": "Organizer post IDs.",
                        "type": "array",
                        "items": {
                            "type": "integer"
                        }
                    },
                    "capacity": {
                        "description": "Event capacity.",
                        "type": "integer"
                    },
                    "online_urls": {
                        "description": "Online event links.",
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "label": {
                                    "type": "string"
                                },
                                "url": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "status": {
                        "description": "Event status.",
                        "type": "string"
                    },
                    "permalink": {
                        "description": "Event permalink.",
                        "type": "string",
                        "format": "uri"
                    }
                }
            },
            "Occurrence": {
                "title": "occurrence",
                "type": "object",
                "properties": {
                    "id": {
                        "description": "Unique identifier for the occurrence.",
                        "type": "integer",
                        "readonly": true
                    },
                    "event_id": {
                        "description": "Event post ID.",
                        "type": "integer"
                    },
                    "start_utc": {
                        "description": "Start time in UTC.",
                        "type": "string"
                    },
                    "end_utc": {
                        "description": "End time in UTC.",
                        "type": "string"
                    },
                    "timezone": {
                        "description": "Occurrence timezone.",
                        "type": "string"
                    },
                    "timeslot_key": {
                        "description": "Timeslot identifier.",
                        "type": "string"
                    },
                    "capacity": {
                        "description": "Occurrence capacity.",
                        "type": "integer"
                    },
                    "status": {
                        "description": "Occurrence status.",
                        "type": "string"
                    }
                }
            }
        }
    }
}
