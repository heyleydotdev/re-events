{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"paths": {
			"@/*": ["./assets/src/admin/*"]
		}
	},
	"include": [
		"assets/src/admin/**/*.ts",
		"assets/src/admin/**/*.tsx",
		"assets/src/admin/**/*.d.ts"
	]
}
